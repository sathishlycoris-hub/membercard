# MySQL connection (used only on the server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=membership

# Public URL that gets encoded inside the QR code (must be reachable from the phone
# that scans the card — use your real domain or LAN IP, not localhost, for phones).
VITE_PUBLIC_BASE_URL=http://localhost:3000

# Staff password that unlocks DOB, phone, Aadhaar and Voter ID on the verify page.
# Choose a long random value. If empty, those details can't be viewed.
ADMIN_PASSWORD=change-me-to-a-long-random-password
